# ESNAS DRC — server/.env (copier et adapter)

PORT=5000
NODE_ENV=production
JWT_SECRET=changez_moi_en_production_min_32_caracteres
JWT_EXPIRES_IN=24h
CORS_ORIGINS=https://votre-frontend.example.com

# --- SQL Server ---
# Local named instance:
DB_SERVER=IP_OU_DNS_CONTABO
DB_INSTANCE=
DB_NAME=DrcAssurancesDB
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_CERT=false
DB_CONNECT_TIMEOUT=30000

# Auth SQL (recommande pour Node)
DB_TRUSTED_CONNECTION=false
DB_USER=esnas_app
DB_PASSWORD=

# Auth Windows (alternative, necessite msnodesqlv8 + driver ODBC)
# DB_TRUSTED_CONNECTION=true

# Tailscale (SQL distant) exemples:
# DB_SERVER=100.x.y.z
# DB_SERVER=mon-pc.tailxxxx.ts.net
# DB_PORT=1433
# DB_INSTANCE=
# Note: base métier ESNAS = DrcAssurancesDB (pas ERP_Administration)
# Ne jamais committer de mots de passe réels.

DB_SERVER_FALLBACK=
DB_INSTANCE_FALLBACK=

PAYMENT_SIMULATION=true
ARCA_TAX_RATE=0.10
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000
OUTBOX_WORKER_ENABLED=false
OUTBOX_WORKER_INTERVAL_MS=5000

# --- Email transactionnel (Resend) ---
# Créer une clé sur https://resend.com/api-keys et vérifier le domaine d'envoi.
RESEND_API_KEY=
EMAIL_FROM=ESNAS DRC <no-reply@votre-domaine.com>
EMAIL_REPLY_TO=support@votre-domaine.com

# --- PayPal (Orders API v2) ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Mobile Money (agrégateur PawaPay) ---
PAWAPAY_ENV=sandbox
PAWAPAY_API_TOKEN=
PAWAPAY_WEBHOOK_SECRET=

# Google Identity (Web Client ID)
GOOGLE_CLIENT_ID=
AUTOMATION_ENABLED=true
AUTOMATION_INTERVAL_MINUTES=60
OUTBOX_WORKER_ENABLED=false
OUTBOX_WORKER_INTERVAL_MS=5000

# Messagerie externe desactivee en phase 2A. Valeur disponible: simulation.
MESSAGING_PROVIDER=simulation
MESSAGING_DEFAULT_CALLING_CODE=243
# Le secours SMS sera branche plus tard uniquement apres un echec WhatsApp confirme.
MESSAGING_SMS_FALLBACK=on_failure
PHONE_VERIFICATION_SECRET=

# Twilio reste inactif tant que MESSAGING_PROVIDER ne vaut pas twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# URL publique exacte: https://votre-api/api/notification/webhook/twilio/status
TWILIO_STATUS_CALLBACK_URL=
# JSON: {"policy.issued_v1":"HX..."}
TWILIO_CONTENT_SIDS={}

# Secret aleatoire distinct d'au moins 32 octets. Ne jamais le changer sans rotation des QR.
QR_TOKEN_SECRET=
HOST=0.0.0.0
# --- Contabo VPS API (gestion serveur/deploiement) ---
# Generer dans le panel client: https://my.contabo.com/api/details
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=
CONTABO_AUTH_TOKEN_URL=https://auth.contabo.com/auth/realms/contabo/protocol/openid-connect/token
CONTABO_API_URL=https://api.contabo.com/v1
# Vérification hôpital publique (optionnel). Si défini, header X-Hospital-Pin requis.
# HOSPITAL_VERIFY_PIN=


# ESNAS DRC — server/.env (copier et adapter)

PORT=5000
NODE_ENV=development
JWT_SECRET=changez_moi_en_production_min_32_caracteres
JWT_EXPIRES_IN=24h
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- SQL Server ---
# Local named instance:
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_NAME=DrcAssurancesDB
DB_ENCRYPT=false
DB_TRUST_CERT=true
DB_CONNECT_TIMEOUT=30000

# Auth SQL (recommande pour Node)
DB_TRUSTED_CONNECTION=false
DB_USER=esnas_app
DB_PASSWORD=

# Auth Windows (alternative, necessite msnodesqlv8 + driver ODBC)
# DB_TRUSTED_CONNECTION=true

# Tailscale (SQL distant) exemples:
# DB_SERVER=100.x.y.z
# DB_SERVER=mon-pc.tailxxxx.ts.net
# DB_PORT=1433
# DB_INSTANCE=
# Note: base métier ESNAS = DrcAssurancesDB (pas ERP_Administration)
# Ne jamais committer de mots de passe réels.

DB_SERVER_FALLBACK=127.0.0.1
DB_INSTANCE_FALLBACK=SQLEXPRESS

PAYMENT_SIMULATION=true
ARCA_TAX_RATE=0.10
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

# Google Identity (Web Client ID)
GOOGLE_CLIENT_ID=
AUTOMATION_ENABLED=true
AUTOMATION_INTERVAL_MINUTES=60
HOST=0.0.0.0

# Vérification hôpital publique (optionnel). Si défini, header X-Hospital-Pin requis.
# HOSPITAL_VERIFY_PIN=


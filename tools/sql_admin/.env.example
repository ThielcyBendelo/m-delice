# Copier vers tools/sql_admin/.env (NE PAS committer les secrets)
# Exemple style ERP existant — adapter pour DrcAssurancesDB

DB_SERVER=100.x.y.z
# DB_SERVER=mon-pc.tailxxxx.ts.net
DB_INSTANCE=SQLEXPRESS
# DB_PORT=1433
DB_NAME=DrcAssurancesDB
DB_USER=esnas_app
DB_PASSWORD=
DB_TRUST_CERT=yes
DB_ENCRYPT=no

# Driver ODBC Windows typique:
# ODBC_DRIVER=ODBC Driver 18 for SQL Server
ODBC_DRIVER=ODBC Driver 17 for SQL Server
